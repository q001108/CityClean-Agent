
# 从DeepSeek官网获取的配置信息
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://your-provider.example/v1

# 从智谱平台获取的配置信息
ZHIPUAI_API_KEY=your_zhipuai_api_key
#ZHPPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHPPUAI_BASE_URL=https://your-provider.example/v1

# 从阿里云百炼平台获取的配置信息
DASHSCOPE_API_KEY=your_dashscope_api_key

# 从OpenRouter平台获取的配置信息
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_API_BASE=your_openrouter_api_base

# 从CloseAI平台获取的配置信息
CLOSEAI_API_KEY=your_closeai_api_key
CLOSEAI_BASE_URL=https://your-provider.example/v1

# langsmith的配置信息
# 是否启用Langsmith监控功能
LANGSMITH_TRACING=true
# Langsmith监控WebUI地址
LANGSMITH_ENDPOINT=https://your-provider.example/v1
# 创建的API_KEY
LANGSMITH_API_KEY=your_langsmith_api_key
# 自定义项目名称，可以在Langsmith WebUI监控页面根据名称查看对应的运行记录
LANGSMITH_PROJECT=your_langsmith_project


# 配置的TavilySearch的API_KEY
TAVILY_API_KEY=your_tavily_api_key

#MinerU的API_TOKEN
MINERU_API_TOKEN=your_mineru_api_token

#使用硅基流动平台
SILICONFLOW_BASE_URL=https://your-provider.example/v1
SILICONFLOW_API_KEY=your_siliconflow_api_key
